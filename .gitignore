# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Personal Claude Code settings (shared ones live in .claude/settings.json)
.claude/settings.local.json

# Claude Code worktrees (full repo copies with their own .next/). Prettier
# reads this file, not .git/info/exclude, so they must be listed here.
.claude/worktrees/

# Supabase CLI cache, rewritten by the CLI itself (update check, service
# versions). The three link files stay committed so every clone and
# worktree is linked to the shared project without `npx supabase link`.
supabase/.temp/*
!supabase/.temp/project-ref
!supabase/.temp/linked-project.json
!supabase/.temp/pooler-url

# Written by `npx supabase start` (CI's throwaway Supabase, #258).
supabase/.branches/
