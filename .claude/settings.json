{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run check)",
      "Bash(npm test)",
      "Bash(npm run lint)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm run dev)",
      "Bash(npx next typegen)",
      "Bash(npx tsc --noEmit)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git log)",
      "Bash(git show *)",
      "Bash(git show)",
      "Bash(git branch)",
      "Bash(git switch *)",
      "Bash(git switch)",
      "Bash(git fetch *)",
      "Bash(git fetch)",
      "Bash(gh issue view *)",
      "Bash(gh issue view)",
      "Bash(gh issue list *)",
      "Bash(gh issue list)",
      "Bash(gh pr view *)",
      "Bash(gh pr view)",
      "Bash(gh pr list *)",
      "Bash(gh pr list)",
      "Bash(gh pr checks *)",
      "Bash(gh pr checks)",
      "Bash(npx supabase migration list *)",
      "Bash(npx supabase migration list)",
      "Bash(npx supabase db push --dry-run *)",
      "Bash(npx supabase db push --dry-run)"
    ],
    "deny": [
      "Bash(npx supabase db reset *)",
      "Bash(npx supabase db reset)",
      "Bash(supabase db reset *)",
      "Bash(supabase db reset)",
      "Bash(npx supabase config push *)",
      "Bash(npx supabase config push)",
      "Bash(supabase config push *)",
      "Bash(supabase config push)",
      "Bash(git push --force *)",
      "Bash(git push --force)",
      "Bash(git push -f *)",
      "Bash(git push -f)",
      "Bash(git push origin main *)",
      "Bash(git push origin main)",
      "Bash(git push origin dev *)",
      "Bash(git push origin dev)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit --no-verify)",
      "Bash(git commit -n *)",
      "Bash(git commit -n)",
      "Bash(git commit * --no-verify)",
      "Bash(git commit * --no-verify *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push * --force-with-lease*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-applied-migrations.mjs\""
          }
        ]
      }
    ]
  }
}
